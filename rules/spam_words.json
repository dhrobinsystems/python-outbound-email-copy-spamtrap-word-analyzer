  "placeholder_patterns": [
    {
      "id": "PH001",
      "pattern": "\\[(?:first[ _]?name|last[ _]?name|full[ _]?name|name|company(?:[ _]?name)?|title|job[ _]?title|your[ _]?name|city|industry|pain[ _]?point|insert[^\\]]*)\\]",
      "message": "Bracket placeholder left in the copy"
    },
    {
      "id": "PH002",
      "pattern": "\\b(?:TODO|TBD|FIXME)\\b",
      "message": "Draft marker left in the copy",
      "case_sensitive": true
    },
    {
      "id": "PH003",
      "pattern": "\\bX{3,}\\b",
      "message": "XXX placeholder left in the copy",
      "case_sensitive": true
    },
    {
      "id": "PH004",
      "pattern": "lorem ipsum",
      "message": "Lorem ipsum filler text left in the copy"
    },
    {
      "id": "PH005",
      "pattern": "<(?:insert|your|company|name)[^<>]{0,40}>",
      "message": "Angle-bracket placeholder left in the copy"
    }
  ],
  "foreign_merge_syntaxes": [
    {
      "name": "Mailchimp merge tag",
      "pattern": "\\*\\|[A-Z0-9_]+\\|\\*",
      "example": "*|FNAME|*"
    },
    {
      "name": "Percent-delimited merge tag",
      "pattern": "%[A-Za-z][A-Za-z0-9_]{2,}%",
      "example": "%FIRSTNAME%"
    },
    {
      "name": "Double angle-bracket merge tag",
      "pattern": "<<\\s*[A-Za-z_][A-Za-z0-9_ ]*\\s*>>",
      "example": "<<First Name>>"
    },
    {
      "name": "Dollar-brace template variable",
      "pattern": "\\$\\{\\s*[A-Za-z_][A-Za-z0-9_.]*\\s*\\}",
      "example": "${firstName}"
    },
    {
      "name": "Liquid / Jinja block tag",
      "pattern": "\\{%-?\\s*[a-z]+[^%]*%\\}",
      "example": "{% if company %}"
    },
    {
      "name": "HubSpot personalization token",
      "pattern": "\\{\\{\\s*(?:contact|company|deal|owner)\\.[a-z0-9_]+\\s*\\}\\}",
      "example": "{{ contact.firstname }}"
    }
  ],
