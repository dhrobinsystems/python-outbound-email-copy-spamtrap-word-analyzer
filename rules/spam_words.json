{
  "name": "outbound-email-copy-spamtrap-word-analyzer rules",
  "version": "1.0.0",
  "description": "Curated, weighted dictionary of spam-trigger and risky phrasing for B2B cold email. Weights are 1 (mild) to 10 (severe). Terms are matched case-insensitively on whole words/phrases after HTML tags, URLs and merge tags are masked. Edit freely: this file is data, not code.",
  "weight_scale": {
    "1-4": "low",
    "5-7": "medium",
    "8-10": "high"
  },
  "categories": {
    "urgency": {
      "label": "False urgency & pressure",
      "description": "Artificial deadlines and pressure language that filters and recipients associate with spam."
    },
    "financial": {
      "label": "Financial & money hooks",
      "description": "Income, money, credit and investment claims typical of scams and bulk promotions."
    },
    "free_offer": {
      "label": "Free offers & giveaways",
      "description": "Free, no-cost and giveaway language. Low weight alone, but stacks quickly."
    },
    "guarantee": {
      "label": "Guarantees & no-risk claims",
      "description": "Absolute promises and risk-reversal claims that read as promotional."
    },
    "aggressive_sales": {
      "label": "Aggressive sales jargon",
      "description": "Hard-sell calls to action and discount language that is out of place in 1:1 cold outreach."
    },
    "deceptive": {
      "label": "Deceptive or phishing-like phrasing",
      "description": "Language that fakes familiarity, prior contact or account/security notices."
    },
    "hype": {
      "label": "Hype & superlatives",
      "description": "Exaggerated claims that lower trust and raise content-filter scores."
    },
    "spam_disclaimer": {
      "label": "Spam self-disclaimers",
      "description": "Phrases that try to pre-empt spam judgement. These are strong spam signals."
    },
    "cliche_tone": {
      "label": "Cold-email cliches & pushy tone",
      "description": "Overused openers and follow-ups. Low filter weight, but they hurt reply rates and mark templated mail."
    },
    "sensitive": {
      "label": "Regulated or high-risk topics",
      "description": "Pharma, gambling, adult and crypto terms that are heavily filtered in B2B mail."
    }
  },
